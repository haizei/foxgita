    "published": "non-nil model.frequency, so baseline may include old frozen frequency whereas optimized separates held readings",
    "publishedWithoutFreshEvidence": "model.frequency non-nil when current window did not have eligible input",
    "firstPcmSeconds": "accumulated input duration to first published locked reading; not device wall latency or p95",
    "confirmationEvents": "entries into model.intonation == inTune; not an independently annotated accuracy metric"
